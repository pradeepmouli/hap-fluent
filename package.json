{
  "name": "hap-fluent-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript monorepo for HAP-Fluent - Type-safe wrapper for Homebridge HAP-NodeJS",
  "keywords": [
    "accessories",
    "characteristics",
    "fluent-api",
    "hap",
    "hap-nodejs",
    "homekit",
    "iot",
    "services",
    "smart-home",
    "type-safe"
  ],
  "homepage": "https://pradeepmouli.github.io/hap-fluent/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/hap-fluent/issues"
  },
  "license": "Apache-2.0",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter '!hap-codegen' run build",
    "test": "pnpm -r --filter '!hap-codegen' run test",
    "lint": "oxlint .",
    "lint:eslint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "oxfmt",
    "format:prettier": "prettier --write .",
    "format:check": "oxfmt --check",
    "type-check": "pnpm -r --filter '!hap-codegen' run type-check",
    "clean": "pnpm -r --filter '!hap-codegen' run clean",
    "docs:dev": "pnpm --filter @hap-fluent/docs dev",
    "docs:build": "pnpm --filter @hap-fluent/docs build",
    "dev": "pnpm -r --filter '!hap-codegen' --parallel run dev",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "homebridge-lib": "^8.1.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@typescript/native-preview": "beta",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}
